# Supply-chain guard: don't install package versions published in the last day.
# Compromised-maintainer publishes are usually caught and unpublished within
# hours, so a short delay avoids the window without holding back real updates.
# Only applies when npm resolves new versions (npm install <pkg> / npm update);
# `npm ci` installs the exact pinned versions from package-lock.json regardless.
min-release-age=1
