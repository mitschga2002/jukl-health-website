# Local development environment. Copy to .env and fill in.
# In production these are set in the Cloudflare Workers environment.

# Transactional email for the contact form (https://resend.com).
# Without it, form submissions fail loudly rather than being silently dropped.
RESEND_API_KEY=

# Optional. Must be a domain verified in Resend.
# Defaults to "JuklHealth <noreply@juklhealth.com>".
RESEND_FROM=
