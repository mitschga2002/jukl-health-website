# Local development environment. Copy to .env and fill in.
# In production these are set in the Cloudflare Workers environment.

# Transactional email for the contact form (https://resend.com).
# Without it, form submissions fail loudly rather than being silently dropped.
RESEND_API_KEY=

# Optional. Must be a domain verified in Resend.
# Defaults to "JuklHealth <noreply@juklhealth.com>".
RESEND_FROM=

# Academy page: the course catalog of the JuklHealth app (https://juklhealth.com/academy).
# Create the key under Einstellungen → Academy → Website-Anbindung in the app and set it
# as a Worker secret in production. Without it the page points to the app instead.
JUKL_CATALOG_API_KEY=
# Optional. Defaults to https://app.juklhealth.com and jukl-health.
# JUKL_APP_URL=https://app.juklhealth.com
# JUKL_ORG_SLUG=jukl-health
